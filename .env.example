# ============================================================
#  SamaDokita V3 — Variables d'environnement (PRODUCTION)
#  Copier :  cp .env.example .env   puis remplir chaque secret.
#  Lancer :  docker compose --env-file .env up -d --build
# ============================================================

# ---------- Base de données ----------
DB_USER=samadokita
DB_PASSWORD=                  # !!! OBLIGATOIRE — générer : openssl rand -hex 24
DB_NAME=samadokita
# DATABASE_URL et DIRECT_DATABASE_URL sont dérivés automatiquement par docker-compose.yml
# (runtime → PgBouncer:6432, migrations → Postgres:5432 direct).

# ---------- Redis ----------
# REDIS_URL est dérivé (redis://redis:6379)

# ---------- Stockage objet S3 (SeaweedFS localement / MinIO en prod) ----------
MINIO_ROOT_USER=              # !!! OBLIGATOIRE
MINIO_ROOT_PASSWORD=          # !!! OBLIGATOIRE — openssl rand -hex 24
# MINIO_BUCKET=samadokita (défini dans docker-compose)

# ---------- Secrets JWT + webhook (OBLIGATOIRE, générer ci-dessous) ----------
JWT_ACCESS_SECRET=            # !!! openssl rand -hex 64
JWT_REFRESH_SECRET=           # !!! openssl rand -hex 64
WEBHOOK_SECRET=               # !!! openssl rand -hex 32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- PgBouncer (pooling transaction, ~800K users) ----------
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MIN_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=10

# ---------- Paiements (comptes marchand réels) ----------
WAVE_API_KEY=
ORANGE_API_KEY=
FREE_MONEY_API_KEY=

# ---------- Application ----------
FRONTEND_URL=https://samadokita.sn
CORS_ORIGINS=https://samadokita.sn
# PORT=3001 (défini dans l'image)
NODE_ENV=production

# ---------- Frontend ----------
# Derrière nginx : appel API relatif "/api" (nginx strip le préfixe).
# En dev local (sans nginx) : http://localhost:3001
NEXT_PUBLIC_API_URL=/api

# ---------- Email (SMTP — requis pour forgot-password + notifications) ----------
SMTP_HOST=                    # ex : smtp.resend.com | smtp.gmail.com | smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SamaDokita <no-reply@samadokita.sn>

# ---------- Monitoring (Sentry — optionnel mais recommandé) ----------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- Backups PostgreSQL (cron) ----------
BACKUP_KEEP=14                # conserver les 14 plus récents
BACKUP_CRON=0 2 * * *         # tous les jours à 02:00 (UTC)
BACKUP_ON_START=1             # backup immédiat au démarrage du conteneur
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_BUCKET=samadokita-backups
BACKUP_S3_ACCESS_KEY=         # laisser vide pour ne pas uploader sur S3
BACKUP_S3_SECRET_KEY=

# ============================================================
#  Génération rapide des secrets (PowerShell) :
#    [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
#  Ou (bash/openssl) :
#    openssl rand -hex 64
# ============================================================
