# ============================================
#  SamaDokita — .gitignore (monorepo)
#  AUCUN secret, dépendance ou artefact de build n'est commité.
# ============================================

# --- Secrets & environnement (JAMAIS commités) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
nginx/certs/*
!nginx/certs/.gitkeep
!nginx/certs/.gitignore

# --- Dépendances ---
node_modules/
.pnp
.pnp.js

# --- Builds & artefacts ---
dist/
build/
.next/
out/
*.tsbuildinfo
frontend/.next/
backend/dist/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build.log
logs/
*.pid

# --- Cache ---
.npm/
.cache/
.eslintcache
.turbo/
.parcel-cache/

# --- Sauvegardes locales ---
backups/
*.sql.gz
*.sql
# ... mais les migrations Prisma sont trackées (elles doivent l'être)
!backend/prisma/migrations/**/*.sql

# --- OS / éditeur ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# --- Divers ---
.vercel
.netlify
coverage/
tmp/
temp/
*.local
opencode.json.txt
